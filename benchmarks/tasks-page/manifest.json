{
  "id": "tasks-page",
  "version": 7,
  "title": "Build Staff Tasks with table and calendar views",
  "featureType": "full-stack",
  "baseRef": "70221361e41a6956abd714130d01c6a7689a1fb9",
  "referenceRef": "e66853e2f89520f707057d47f7f938b1d563c596",
  "guidance": {
    "ref": "e66853e2f89520f707057d47f7f938b1d563c596",
    "paths": [
      "AGENTS.md",
      ".agents/skills/develop-feature",
      "backend/README.md",
      "docs/architecture",
      "docs/development",
      "docs/features",
      "docs/workflows",
      "frontend/README.md",
      "scripts/tests/backend/run-task-tests.sh",
      "scripts/tests/frontend/run-task-tests.sh"
    ]
  },
  "promptFile": "prompt.md",
  "reasoningEfforts": ["low", "medium", "high"],
  "timeoutMinutes": 90,
  "evaluationTimeoutMinutes": 30,
  "isolation": {
    "dockerComposeServices": ["frontend", "nginx", "backend", "db", "db_test"]
  },
  "repetitions": 3,
  "models": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"],
  "checks": [
    { "id": "diff", "label": "Diff integrity", "points": 5, "command": ["git", "diff", "--check"] },
    { "id": "patterns", "label": "Repository patterns", "points": 5, "command": ["node", "scripts/agents/check-patterns.js", "--changed", "{baseSha}"] },
    { "id": "static", "label": "Static analysis", "points": 10, "command": ["bash", "scripts/tests/test-static.sh"] },
    { "id": "backend", "label": "Focused Tasks backend runner", "points": 15, "appliesTo": ["backend", "full-stack"], "command": ["bash", "scripts/tests/backend/run-task-tests.sh"] },
    { "id": "frontend", "label": "Focused Tasks frontend runner", "points": 15, "appliesTo": ["frontend", "full-stack"], "command": ["bash", "scripts/tests/frontend/run-task-tests.sh"] },
    { "id": "application", "label": "Composed changed-application gate", "points": 10, "appliesTo": ["full-stack"], "command": ["bash", "scripts/tests/test-app.sh", "--changed", "{baseSha}"] }
  ],
  "requirements": [
    { "id": "persistence", "label": "Adds task persistence and generated database types", "points": 4, "appliesTo": ["backend", "full-stack"], "files": ["backend/db/migrations/*task*.sql"] },
    { "id": "backend-layers", "label": "Implements layered task API code and focused tests", "points": 7, "appliesTo": ["backend", "full-stack"], "files": ["backend/src/routes/*task*.ts", "backend/src/controllers/*task*.ts", "backend/src/services/*task*.ts", "backend/tests/tasks/**/*.test.ts"] },
    { "id": "frontend-layers", "label": "Implements a typed Tasks feature with focused tests", "points": 7, "appliesTo": ["frontend", "full-stack"], "files": ["frontend/src/pages/Staff/Tasks/**/*.tsx", "frontend/src/pages/Staff/Tasks/**/*.test.tsx"] },
    { "id": "view-parity", "label": "Uses the shared table and resource calendar", "points": 5, "appliesTo": ["frontend", "full-stack"], "contains": ["Table", "ResourceCalendar"] },
    { "id": "page-controls", "label": "Provides shared header controls and persisted preferences", "points": 4, "appliesTo": ["frontend", "full-stack"], "contains": ["PageHeader", "ViewMenu", "useUserPreference"] },
    { "id": "workflows", "label": "Implements task and confirmation modal workflows", "points": 4, "appliesTo": ["frontend", "full-stack"], "contains": ["Modal", "useConfirmModal"] },
    { "id": "time-link", "label": "Links time entries to tasks", "points": 4, "appliesTo": ["backend", "full-stack"], "contains": ["taskId", "time"] },
    { "id": "narrow-mutations", "label": "Uses focused status and placement mutations", "points": 5, "appliesTo": ["backend", "full-stack"], "contains": ["status", "placement", "patch"] }
  ],
  "reviewSections": [
    {
      "id": "backend",
      "label": "Backend implementation",
      "appliesTo": ["backend", "full-stack"],
      "items": [
        { "id": "migrations", "label": "Database migrations", "patterns": ["backend/db/migrations/*task*.sql"] },
        { "id": "routes", "label": "Routes", "patterns": ["backend/src/routes/*task*.ts"] },
        { "id": "controllers", "label": "Controllers", "patterns": ["backend/src/controllers/*task*.ts"] },
        { "id": "services", "label": "Services", "patterns": ["backend/src/services/*task*.ts"] },
        { "id": "policies", "label": "Policies", "patterns": ["backend/src/policies/*task*.ts"] },
        { "id": "tests", "label": "Focused backend tests", "patterns": ["backend/tests/tasks/**/*.test.ts"] }
      ]
    },
    {
      "id": "frontend",
      "label": "Frontend implementation",
      "appliesTo": ["frontend", "full-stack"],
      "items": [
        { "id": "page", "label": "Tasks page", "patterns": ["frontend/src/pages/Staff/Tasks/Tasks.tsx"] },
        { "id": "page-tests", "label": "Page tests", "patterns": ["frontend/src/pages/Staff/Tasks/Tasks.test.tsx"] },
        { "id": "components", "label": "Feature components", "patterns": ["frontend/src/pages/Staff/Tasks/components/**/*.tsx"] },
        { "id": "component-tests", "label": "Component tests", "patterns": ["frontend/src/pages/Staff/Tasks/components/**/*.test.tsx"] },
        { "id": "hooks", "label": "Feature hooks", "patterns": ["frontend/src/pages/Staff/Tasks/hooks/**/*.ts", "frontend/src/pages/Staff/Tasks/components/**/hooks/**/*.ts"] }
      ]
    }
  ]
}
