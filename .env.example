# Absolute host paths. Docker mounts both at the same paths inside the app
# container so nested target-repository Docker Compose projects can resolve
# their worktrees through the host Docker daemon.
AGENT_INSIGHTS_REPOSITORY_PATH=/absolute/path/to/repository
AGENT_INSIGHTS_RUNTIME_PATH=/absolute/path/to/agent-insights-runtime

# Leave this as /dev/null unless the selected, trusted repository launches
# Docker. Docker-enabled runs require /var/run/docker.sock and grant the app
# host-level container control.
AGENT_INSIGHTS_DOCKER_SOCKET_PATH=/dev/null

AGENT_INSIGHTS_PORT=4173
CODEX_VERSION=0.147.0

# Override only when intentionally selecting different persistent state.
# AGENT_INSIGHTS_APP_DATA_VOLUME=agent-insights_app_data
# AGENT_INSIGHTS_CODEX_STATE_VOLUME=agent-insights_codex_state
